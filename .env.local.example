# Copy this file to .env.local and fill in real values
# Never commit .env.local to git

# MongoDB — required for blog system, admin panel, and contact form
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.example.mongodb.net/solid-website?retryWrites=true&w=majority

# Site URL (used for canonical URLs and OG metadata)
NEXT_PUBLIC_SITE_URL=https://www.gdprconsultants.in

# Admin panel credentials
ADMIN_EMAIL=admin@dpdpconsultants.com
ADMIN_PASSWORD=Admin@2025!

# Dev server port
PORT=4000
