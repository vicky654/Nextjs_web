# Copy this file to .env.local and fill in real values
# Never commit .env.local to git

# PostgreSQL — required for blog system
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gdpr_db
DB_USER=postgres
DB_PASSWORD=yourpassword

# Site URL (used for canonical URLs and OG metadata)
NEXT_PUBLIC_SITE_URL=https://www.gdprconsultants.in

# Admin panel credentials (defaults shown — change in production)
ADMIN_EMAIL=admin@dpdpconsultants.com
ADMIN_PASSWORD=Admin@2025!
# Optional: use SHA-256 hash instead of plaintext password
# ADMIN_PASSWORD_HASH=<sha256(password + "dpdp_salt_2025")>

# Client portal credentials (defaults shown — change in production)
PORTAL_EMAIL=user@dpdpconsultants.com
PORTAL_PASSWORD=User@2025!
